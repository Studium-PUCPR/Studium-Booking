{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=studium_booking;Username=postgres;Password=postgres"
  },
  "Booking": {
    "DefaultTimeZone": "America/Sao_Paulo",
    "GraceMinutesBeforeCheckIn": 15,
    "GraceMinutesAfterCheckIn": 15,
    "MaxNoShowsBeforeSuspension": 3,
    "DefaultSuspensionDays": 7
  },
  "AWS": {
    "Region": "us-east-2",
    "Cognito": {
      "UserPoolId": "",
      "ClientId": "",
      "Authority": ""
    },
    "SQS": {
      "BookingQueueName": "studium-booking-events-queue",
      "UsersQueueName": "studium-users-events-queue",
      "NotificationsQueueName": "studium-notifications-queue"
    }
  }
}
